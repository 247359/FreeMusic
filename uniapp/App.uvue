<script setup>
import { initApp, applyTheme, savePlaybackProgress } from './common/store.js'
import { initPlayerEngine, refreshSleepTimer } from './common/player.js'
import { isConfigured, fetchLikedIds } from './common/api.js'
import { refreshSafeArea } from './common/config.js'

onLaunch(() => {
	initApp()
	initPlayerEngine()
	applyTheme()
	// 冷启动时从服务端重建星标，避免首页/播放页显示陈旧的喜欢状态
	if (isConfigured()) fetchLikedIds().catch(() => {})
})

onAppShow(() => {
	refreshSafeArea()
	applyTheme()
	refreshSleepTimer()
})

onAppHide(() => {
	savePlaybackProgress()
})

onError((err) => {
	console.error('[FreeMusic] App error:', err)
})
</script>

