<template>
	<view class="nav-header" :class="themeClass" :style="{ paddingTop: statusBar + 'px' }">
		<view class="bar">
			<view v-if="props.showBack" class="left" @click="back">
				<AppIcon name="arrow-left" :size="20" />
			</view>
			<text class="title ellipsis">{{ props.title }}</text>
			<view class="right"><slot name="right"></slot></view>
		</view>
	</view>
</template>

<script setup>
import AppIcon from './AppIcon.uvue'
import { statusBarHeight } from '../common/config.js'
import { themeState } from '../common/store.js'

const props = defineProps({
	title: { type: String, default: '' },
	showBack: { type: Boolean, default: true }
})

const themeClass = computed(() => (themeState.isDark ? 'theme-dark' : 'theme-light'))
const statusBar = computed(() => statusBarHeight())

function back() {
	const pages = getCurrentPages()
	if (pages.length > 1) uni.navigateBack()
	else uni.reLaunch({ url: '/pages/index/index' })
}
</script>

<style scoped>
.nav-header {
	position: fixed;
	left: 0;
	right: 0;
	top: 0;
	z-index: 90;
	background-color: var(--bg);
}
.bar {
	height: 48px;
	display: flex;
	flex-direction: row;
	align-items: center;
	padding-left: 4px;
	padding-right: 12px;
}
.left {
	width: 44px;
	height: 48px;
	flex-shrink: 0;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
}
.right {
	min-width: 44px;
	height: 48px;
	flex-shrink: 0;
	margin-left: 8px;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: flex-end;
}
.title {
	flex: 1;
	min-width: 0;
	height: 48px;
	line-height: 48px;
	margin-left: 6px;
	text-align: left;
	font-size: 17px;
	font-weight: 400;
	color: var(--text);
	opacity: 0.9;
}
</style>
