<template>
	<view class="section" :class="{ tight: props.tight }">
		<text class="title">{{ props.title }}</text>
		<view class="section-actions">
			<TrackSelectionButton :tracks="props.tracks" />
			<view v-if="props.more" class="more press" @click="emit('more')">
				<text class="more-text">更多</text>
				<AppIcon name="arrow-right" :size="13" :opacity="0.68" />
			</view>
		</view>
	</view>
</template>

<script setup>
import TrackSelectionButton from './TrackSelectionButton.uvue'
import AppIcon from './AppIcon.uvue'

const props = defineProps({
	title: { type: String, required: true },
	tracks: { type: Array, default: () => [] },
	more: { type: Boolean, default: false },
	/** 作为行内标题使用时不带底部间距（由父级控制） */
	tight: { type: Boolean, default: false }
})
const emit = defineEmits(['more'])
</script>

