<template>
	<view class="library">
		<view class="user" :class="themeClass">
			<view class="avatar">
				<text class="avatar-text">{{ initial }}</text>
			</view>
			<view class="user-info">
				<text class="nickname">{{ user.username || '未连接' }}</text>
				<text class="server ellipsis">{{ user.server || '请在设置中连接 Navidrome 服务' }}</text>
			</view>
			<view class="user-btn press" @click="goSettings">
				<AppIcon name="settings" :size="21" :opacity="0.62" />
			</view>
		</view>

		<view class="content">
			<view class="quick">
				<view class="like-card press" @click="goAllSongs">
					<AppIcon name="list" color="light" :size="30" />
					<view class="f-1">
						<text class="qc-title">全部歌曲</text>
						<text class="qc-sub">浏览服务器曲库</text>
					</view>
					<AppIcon name="arrow-right" color="light" :size="18" :opacity="0.7" />
				</view>
				<view class="mini-quick">
					<view class="mq press" @click="goFavorites">
						<AppIcon name="heart-solid" color="primary" :size="19" />
						<text class="mq-label">我的收藏</text>
					</view>
					<view class="mq press" @click="goMostPlayed">
						<AppIcon name="sort-up" color="primary" :size="19" />
						<text class="mq-label">最常播放</text>
					</view>
				</view>
			</view>

			<view class="block">
				<view class="section-head">
					<SectionTitle title="我的歌单" :tight="true" />
					<view class="sec-btn press" @click="createPlaylist">
						<AppIcon name="plus" :size="18" :opacity="0.72" />
					</view>
				</view>
				<PageState :loading="loading" :error="error" @retry="load">
					<view v-if="playlists.length" class="playlist-rows">
						<view
							v-for="p in playlists"
							:key="p.id"
							class="pl-row press"
							@click="detail(p)"
						>
							<image v-if="p.picUrl" class="pl-cover cover-img" :src="p.picUrl" mode="aspectFill"></image>
							<view v-else class="pl-cover pl-placeholder"><AppIcon name="list" color="primary" :size="20" :opacity="0.6" /></view>
							<view class="pl-info">
								<text class="pl-name ellipsis">{{ p.name }}</text>
								<text class="pl-sub">{{ p.trackCount }} 首 · {{ p.creator || 'Navidrome' }}</text>
							</view>
							<AppIcon name="arrow-right" :size="17" :opacity="0.4" />
						</view>
						<view class="playlist-end">
							<text class="playlist-end-label">没有更多了</text>
						</view>
					</view>
					<view v-else class="empty">
						<text class="empty-text">把想一起听的歌曲放进同一张歌单</text>
						<view class="create-empty press" @click="createPlaylist">
							<AppIcon name="plus" color="primary" :size="16" />
							<text class="create-empty-label">新建歌单</text>
						</view>
					</view>
				</PageState>
			</view>

		</view>
	</view>
</template>

<script setup>
import AppIcon from '../AppIcon.uvue'
import PageState from '../PageState.uvue'
import SectionTitle from '../SectionTitle.uvue'
import { user, useTheme } from '../../common/store.js'
import * as api from '../../common/api.js'
import { goDetail, goFavorites, goList, goSettings } from '../../common/actions.js'
import { toast } from '../../common/format.js'

const props = defineProps({
	active: { type: Boolean, default: false }
})

const theme = useTheme()
const themeClass = computed(() => theme.themeClass())
const initial = computed(() => (user.username || 'N').slice(0, 1).toUpperCase())

const loading = ref(true)
const error = ref('')
const loaded = ref(false)
const playlists = ref([])

watch(
	() => props.active,
	(v) => {
		if (v && !loaded.value) load()
	},
	{ immediate: true }
)

/** 供父级在账户切换后强制刷新 */
function reload() {
	loaded.value = false
	load()
}
defineExpose({ reload })

function createPlaylist() {
	uni.showModal({
		title: '新建歌单',
		editable: true,
		placeholderText: '输入歌单名称',
		success: (res) => {
			const name = (res.content || '').trim()
			if (!res.confirm || !name) return
			api
				.createPlaylist(name)
				.then(() => {
					toast('已创建歌单')
					load()
				})
				.catch((e) => toast(e.message || '创建失败'))
		}
	})
}

function load() {
	loaded.value = true
	loading.value = true
	error.value = ''
	Promise.all([
		api.getPlaylists(),
		api.fetchLikedIds().catch(() => [])
	])
		.then(([list]) => {
			playlists.value = list || []
			loading.value = false
		})
		.catch((e) => {
			error.value = e.message || '加载失败'
			loading.value = false
		})
}

function goAllSongs() {
	goList('library', '', '全部歌曲')
}

function goMostPlayed() {
	goList('mostPlayed', '', '最常播放')
}

function detail(item) {
	goDetail('playlist', item)
}

</script>

