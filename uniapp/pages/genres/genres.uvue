<template>
	<view class="page" :class="themeClass">
		<NavHeader title="流派浏览" />
		<view :style="{ height: headerH + 'px' }"></view>
		<scroll-view
			class="scroll"
			:show-scrollbar="false"
			scroll-y
			:style="{ top: headerH + 'px', bottom: bottomH + 'px' }"
		>
			<PageState :loading="loading" :error="error" @retry="load">
				<view class="genre-grid">
					<view
						v-for="g in genres"
						:key="g.name"
						class="genre-card press"
						@click="openGenre(g)"
					>
						<text class="g-name ellipsis">{{ genreLabel(g.name) }}</text>
						<text class="g-sub">{{ g.songCount }} 首歌曲</text>
					</view>
					<view v-if="!genres.length" class="empty"><text class="empty-text">没有找到流派信息</text></view>
				</view>

			</PageState>
		</scroll-view>
		<MiniPlayer :with-nav="false" />
	</view>
</template>

<script setup>
import NavHeader from '../../components/NavHeader.uvue'
import PageState from '../../components/PageState.uvue'
import MiniPlayer from '../../components/MiniPlayer.uvue'
import { headerHeight, miniPlayerClearance } from '../../common/config.js'
import { player, themeState } from '../../common/store.js'
import * as api from '../../common/api.js'
import { genreLabel } from '../../common/format.js'
import { goList } from '../../common/actions.js'

const genres = ref([])
const loading = ref(true)
const error = ref('')

const themeClass = computed(() => (themeState.isDark ? 'theme-dark' : 'theme-light'))
const headerH = computed(() => headerHeight())
const bottomH = computed(() => miniPlayerClearance(player.visible) + 8)

onLoad(() => load())

function load() {
	loading.value = true
	error.value = ''
	api
		.getGenres()
		.then((list) => {
			genres.value = list || []
			loading.value = false
		})
		.catch((e) => {
			error.value = e.message || '加载失败'
			loading.value = false
		})
}

function openGenre(g) {
	goList('genre', g.name, genreLabel(g.name))
}
</script>

<style scoped>
.page {
	height: 100%;
	background-color: var(--bg);
}
.scroll {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
}
.back-genres {
	height: 48px;
	flex-shrink: 0;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: flex-end;
}
.back-text {
	font-size: 13px;
	font-weight: 400;
	color: var(--primary);
}
.genre-grid {
	padding: 14px 16px 24px;
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
	justify-content: space-between;
}
.genre-card {
	width: calc(50% - 5px);
	margin-bottom: 10px;
	padding: 16px 14px;
	border-radius: 12px;
	background-color: var(--secondary-bg);
	display: flex;
	flex-direction: column;
}
.g-name {
	font-size: 15px;
	font-weight: 400;
	color: var(--text);
}
.g-sub {
	font-size: 11px;
	color: var(--text);
	opacity: 0.58;
	margin-top: 5px;
}
.grid-wrap {
	padding: 12px 16px 24px;
}
.grid {
	display: flex;
	flex-direction: row;
	flex-wrap: wrap;
}
.empty {
	display: flex;
	flex-direction: row;
	justify-content: center;
	align-items: center;
	width: 100%;
	padding: 60px 0;
}
.empty-text {
	font-size: 13px;
	color: var(--text);
	opacity: 0.58;
	text-align: center;
}
</style>
