	width: 64px;
	height: 64px;
	border-radius: 18px;
	background: linear-gradient(to right, #335eea 0%, #6b8cf3 100%);
	display: flex;
	align-items: center;
	justify-content: center;
	box-shadow: 0 12px 24px -8px rgba(51, 94, 234, 0.6);
}
.title {
	font-size: 21px;
	font-weight: 600;
	color: var(--text);
	margin-top: 18px;
}
.desc {
	font-size: 12px;
	color: var(--text);
	opacity: 0.58;
	line-height: 20px;
	text-align: center;
	margin-top: 8px;
}
.form {
	padding: 20px 20px 0;
}
.field {
	margin-bottom: 16px;
}
.label {
	font-size: 12px;
	font-weight: 400;
	color: var(--text);
	opacity: 0.78;
}
.input {
	height: 42px;
	border-radius: 9px;
	background-color: var(--secondary-bg);
	margin-top: 8px;
	padding: 0 12px;
	font-size: 14px;
	color: var(--text);
}
.ph {
	color: var(--text);
	opacity: 0.4;
}
.tip {
	font-size: 11px;
	color: var(--text);
	opacity: 0.45;
	margin-top: 6px;
}
.error {
	font-size: 12px;
	color: #e0533d;
	margin: 4px 0 10px;
}
.primary-btn {
	height: 44px;
	border-radius: 10px;
	background-color: var(--primary);
	color: #ffffff;
	font-size: 15px;
	font-weight: 400;
	display: flex;
	align-items: center;
	justify-content: center;
	margin-top: 6px;
}
.docker {
	margin: 34px 20px 40px;
}
.docker-desc {
	font-size: 12px;
	color: var(--text);
	opacity: 0.58;
	line-height: 20px;
}
.code {
	background-color: var(--secondary-bg);
	border-radius: 10px;
	padding: 14px;
	margin-top: 12px;
	font-size: 11px;
	line-height: 19px;
	color: var(--text);
	opacity: 0.88;
	white-space: pre-wrap;
}
.docker-tip {
	display: flex;
	font-size: 11px;
	color: var(--text);
	opacity: 0.45;
	line-height: 18px;
	margin-top: 10px;
}
.primary-label { color: #ffffff; }
</style>
