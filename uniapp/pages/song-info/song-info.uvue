<template>
	<view class="overlay" :class="themeClass()" @click="close">
		<view class="dialog" @click.stop>
			<text class="title" :max-lines="2">{{ title }}</text>
			<text class="content">{{ content }}</text>
			<button class="confirm" @click="close">知道了</button>
		</view>
	</view>
</template>

<script setup>
import { useTheme } from '../../common/store.js'

const { themeClass } = useTheme()
const title = ref('歌曲信息')
const content = ref('')

onLoad((options) => {
	title.value = decodeURIComponent(options.title || '歌曲信息')
	content.value = decodeURIComponent(options.content || '')
})

function close() {
	uni.closeDialogPage()
}
</script>

